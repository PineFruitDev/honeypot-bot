DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_bot_client_id_here
DEVELOPER_IDS=your_user_id_here  # Optional: comma-separated user IDs for developer-only commands
NODE_ENV=production              # Optional: development enables debug logging and guild-scoped command registration
DATA_DIR=data                    # Optional: where per-guild trap config is persisted
DEV_GUILD_ID=                    # Optional: test guild for command registration when NODE_ENV is not production
